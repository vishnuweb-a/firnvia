PORT=4000
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (needed so AirPay can reach the callback).
# Locally, use an ngrok https URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:4000

# ---- AirPay v4 credentials (from AirPay merchant settings / dev portal) ----
AIRPAY_MERCHANT_ID=362380
AIRPAY_CLIENT_ID=rXhhrZ
AIRPAY_CLIENT_SECRET=        # for OAuth2  (REQUIRED)
AIRPAY_USERNAME=             # settings page (REQUIRED)
AIRPAY_PASSWORD=             # settings page (REQUIRED)
AIRPAY_SECRET=               # settings page; used for privatekey (REQUIRED)
# Leave blank to auto-derive md5(username~:~password). Only set if AirPay gave
# you a separate encryption key.
AIRPAY_ENCRYPTION_KEY=

# Endpoints (override only if AirPay gives you sandbox-specific URLs)
AIRPAY_OAUTH_URL=https://kraken.airpay.co.in/airpay/pay/v4/api/oauth2/
AIRPAY_PAY_URL=https://payments.airpay.co.in/pay/v4/

# TLS certificate verification for AirPay calls.
# MUST be false (or omitted) in production -- "true" disables certificate
# verification and is a local demo escape hatch only. Never set this to true in
# the Vercel production environment.
AIRPAY_INSECURE_TLS=false

# ---- PayU Hosted Checkout ----
# PAYU_ENV selects which PayU endpoints to use: test | production
PAYU_ENV=test

# Merchant credentials from the PayU dashboard. Server-side only --
# never expose these to the frontend (no VITE_/REACT_APP_/NEXT_PUBLIC_ copies).
PAYU_KEY=
PAYU_SALT=

# Optional: PayU OAuth client credentials, if used for server-to-server APIs.
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# Endpoints -- test values shown below.
# Production: https://secure.payu.in/_payment
PAYU_PAYMENT_URL=https://test.payu.in/_payment
# Production: https://info.payu.in/merchant/postservice.php?form=2
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice.php?form=2

# ── SabPaisa (PG 3.0 REST) ────────────────────────────────────────────────────
# SabPaisa PG 3.0 REST API: JSON over HTTPS, X-Api-Key auth, HMAC-SHA256
# checksums, hosted checkout by redirect, S2S webhooks and Transaction Enquiry.
# NOT the older securepay.sabpaisa.in encData/authKey/authIV AES integration.
#
# Credentials needed to START a payment. Without all three the initiate route
# returns 503; it never falls back to a simulated success.
SABPAISA_CLIENT_CODE=
SABPAISA_API_KEY=
SABPAISA_SECRET_KEY=
SABPAISA_PAY_URL=https://merchant-api.sabpaisa.in/api/v2/payments

# Required to ACCEPT the server-to-server webhook. The webhook fails CLOSED
# without it: POST /api/payment/sabpaisa/webhook returns 503 rather than
# trusting an unverifiable payload.
SABPAISA_WEBHOOK_SECRET=

# Transaction Enquiry endpoint — the SabPaisa analogue of PayU's Verify Payment
# API, and the ONLY authority that can settle a SabPaisa order. Neither the
# browser return nor the signed webhook marks an order paid on its own; both
# reconcile through this endpoint, which also supplies the canonical integer
# `amountPaise` compared against order.total. While it is blank, nothing can
# reach "paid": the webhook returns 503 and the browser return reports pending.
SABPAISA_ENQUIRY_URL=https://merchant-api.sabpaisa.in/api/v2/payments/enquiry

# Guards the development-only simulate route. Anything other than "development"
# or "test" (including unset) disables POST /api/payment/*/simulate/:orderId.
NODE_ENV=development
